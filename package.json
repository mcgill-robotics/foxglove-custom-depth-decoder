{
  "name": "foxglove-custom-depth-decoder",
  "displayName": "Foxglove Custom Depth Decoder",
  "description": "Foxglove Schema Converter to decode 16-bit PNG depth maps into native 16UC1 image topics.",
  "publisher": "mcgill-robotics",
  "homepage": "https://github.com/mcgill-robotics/foxglove-custom-depth-decoder",
  "version": "1.0.0",
  "license": "MIT",
  "main": "./dist/extension.js",
  "keywords": [
    "foxglove",
    "depth",
    "png",
    "converter",
    "16UC1"
  ],
  "scripts": {
    "build": "foxglove-extension build",
    "foxglove:prepublish": "foxglove-extension build --mode production",
    "lint": "eslint .",
    "lint:ci": "eslint .",
    "lint:fix": "eslint --fix .",
    "local-install": "foxglove-extension install",
    "package": "foxglove-extension package",
    "publish-org": "npm run package && foxglove extensions publish ./mcgill-robotics.foxglove-custom-depth-decoder-1.0.0.foxe",
    "pretest": "foxglove-extension pretest"
  },
  "devDependencies": {
    "@foxglove/eslint-plugin": "2.1.2",
    "@foxglove/extension": "2.54.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "create-foxglove-extension": "1.3.2",
    "eslint": "9.39.4",
    "prettier": "3.8.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "fast-png": "^8.0.0"
  }
}
